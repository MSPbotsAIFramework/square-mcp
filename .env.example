# ─── Square API Credentials ──────────────────────────────────────────────────
# Access token used in env mode (single shared credential loaded from environment).
# Not required when AUTH_MODE=gateway (token is provided per-request via header).
SQUARE_ACCESS_TOKEN=your_access_token_here

# Square API version pinned by this service (controls the response shapes it
# parses). Overridable for testing against a different Square API release.
SQUARE_API_VERSION=2024-07-17

# HTTP header name that carries the access token in gateway mode.
# The client must send this header on every /mcp request.
SQUARE_AUTH_HEADER=X-Square-Access-Token

# HTTP header name that selects the Square environment ("production" or
# "sandbox") in gateway mode.
SQUARE_ENV_HEADER=X-Square-Environment

# ─── MCP Transport ───────────────────────────────────────────────────────────
# "http"  — stateless HTTP server (required for production / multi-tenant use)
# "stdio" — local stdio transport (useful for development / CLI use)
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ─── Auth Mode ───────────────────────────────────────────────────────────────
# "gateway" — (default, SOP-compliant) token provided per-request via the SQUARE_AUTH_HEADER HTTP header
#             Required for production / multi-tenant deployments (e.g. behind mcp-gateway).
# "env"     — (local dev only) single token loaded from SQUARE_ACCESS_TOKEN environment variable
#             NOT SOP-compliant: token is shared across all requests; do not use in production.
AUTH_MODE=gateway
